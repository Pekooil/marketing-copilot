# Public, non-secret runtime identity
APP_ENV=development
APP_VERSION=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public Supabase connection values. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-evaluated release controls and privacy-safe correlation.
FEATURE_AUTHENTICATION=on
FEATURE_ONBOARDING=on
OBSERVABILITY_HASH_SALT=
