# Public, non-secret runtime identity
APP_ENV=development
APP_VERSION=local
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public Supabase connection values. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-evaluated release controls and privacy-safe correlation.
FEATURE_AUTHENTICATION=on
FEATURE_ONBOARDING=on
OBSERVABILITY_HASH_SALT=

# Sprint 4 connector runtime. Server-only; configure per environment in Vercel.
CONNECTOR_STATE_SECRET=
# PostgreSQL credential allowed to SET ROLE app_worker. Supabase Vault is accessed
# only through the worker-only database functions; no separate vault token is used.
CONNECTOR_DATABASE_URL=
