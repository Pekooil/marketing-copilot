{
  "name": "marketing-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:component && pnpm test:integration && pnpm test:isolation && pnpm test:evaluation",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration",
    "test:isolation": "vitest run --project isolation",
    "test:evaluation": "vitest run --project evaluation",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:release": "pnpm lint && pnpm typecheck && pnpm schema:check && pnpm migration:check && pnpm test && pnpm build && pnpm test:e2e",
    "schema:check": "node scripts/validate-schemas.mjs",
    "migration:check": "node scripts/validate-migrations.mjs",
    "db:generate": "drizzle-kit generate",
    "db:apply": "node --env-file-if-exists=.env.local scripts/apply-migrations.mjs",
    "db:gate": "node --env-file-if-exists=.env.local scripts/run-db-gate.mjs",
    "db:rehearse": "node --env-file-if-exists=.env.local scripts/rehearse-migrations.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "demo:sprint1": "node scripts/sprint1-demo.mjs",
    "demo:sprint2": "node scripts/sprint2-demo.mjs",
    "ci": "pnpm lint && pnpm typecheck && pnpm schema:check && pnpm migration:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
